<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RocketMultiBoot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/bg_dark</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>

    <style name="BtnAccent" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/bg</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="BtnSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/accent</item>
        <item name="android:textColor">@color/accent</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="BtnDanger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/err</item>
        <item name="android:textColor">@color/err</item>
        <item name="cornerRadius">6dp</item>
    </style>
</resources>
